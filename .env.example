# netdisk-lfs 环境变量示例
#
# 真实值写进同目录的 .env（已在 .gitignore 中排除，绝不入库）；
# 本文件只保留占位值，不要填真实路径、令牌或口令。
# 程序从「当前工作目录」读取 .env，不向父目录查找。
# 键名语义见 .agents/plans/2026-11-24-execution-plan.md 的「.env 契约」一节。
#
# ── 生产部署（systemd）不需要 .env 文件 ─────────────────────────────
# deploy/netdisk-lfs.service 用 `Environment=` 注入运行期变量，且
# `WorkingDirectory=/var/lib/netdisk-lfs`，那里没有 .env，程序读不到也不算错误：
#
#   NETDISK_LFS_ENV=prod            日志走 JSON、默认 info 级别
#   NETDISK_LFS_DATA_DIR=/var/lib/netdisk-lfs
#                                   上传缓冲取 <dir>/upload；config.toml 里 cache.dir
#                                   通常写成 <dir>/cache（两者保持同一根）
#   PATH=/home/lixinlong/.local/bin:/usr/local/bin:/usr/bin:/bin
#                                   bdpan 与它可能调用的同目录工具都在这里
#
# 生产上**不需要** NETDISK_LFS_CONFIG：unit 的 ExecStart 用 --config 显式给路径，
# `--config` 的优先级高于环境变量。也**不要**在服务器上放 .env：配置只有
# /etc/netdisk-lfs/config.toml 一处（600），少一个会被误改的来源。
#
# ── 本地开发 ────────────────────────────────────────────────────────
# 开发时把本文件复制成 .env 再填真实值；下列四项就是开发要用的全部变量。

# 运行环境：dev（人类可读日志、默认 debug 级别）或 prod（JSON 日志、默认 info 级别）
NETDISK_LFS_ENV=dev

# bdpan CLI 的绝对路径；设置后覆盖 config.toml 里的 storage.bdpan_bin
BDPAN_BIN=/path/to/bdpan

# 运行配置文件路径（TOML）；不传 --config 时使用，再缺省为 ./config.toml
NETDISK_LFS_CONFIG=/path/to/config.toml

# 本地数据根：cache.dir 缺省取 $NETDISK_LFS_DATA_DIR/cache，上传缓冲取
# $NETDISK_LFS_DATA_DIR/upload；未设置时上传缓冲退回系统临时目录（仅供开发，
# 生产部署必须设置本变量，否则大对象缓冲可能被重启清空）
NETDISK_LFS_DATA_DIR=/path/to/netdisk-lfs-data

# --- 以下仅测试用：tests/fixtures/bdpan 桩脚本的环境变量 ---
# 集成测试通过子进程环境注入这些值，不读取真实 .env；运行服务时一律不需要它们。
# 桩把远端 /apps/bdpan/ 映射到 FAKE_BDPAN_ROOT，绝不可能访问真实网盘。
# FAKE_BDPAN_ROOT=/tmp/netdisk-lfs-bdpan-remote
# FAKE_BDPAN_CALL_LOG=/tmp/netdisk-lfs-bdpan-calls.log
# 故障注入开关：非空即生效；SILENT_TRUNCATE 模拟「下载报成功但内容截断」的静默失败
# FAKE_BDPAN_FAIL_UPLOAD=
# FAKE_BDPAN_SILENT_TRUNCATE=
# FAIL_AUTH 让 whoami 报 token 过期，用于 /healthz 的 auth_failed 用例
# FAKE_BDPAN_FAIL_AUTH=
# 配额数值（字节），默认 1 TiB / 0
# FAKE_BDPAN_QUOTA_TOTAL=1099511627776
# FAKE_BDPAN_QUOTA_USED=0
