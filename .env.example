# netdisk-lfs 本机环境变量示例
#
# 真实值写进同目录的 .env（已在 .gitignore 中排除，绝不入库）；
# 本文件只保留占位值，不要填真实路径、令牌或口令。
# 程序从「当前工作目录」读取 .env，不向父目录查找。
# 键名语义见 .agents/plans/2026-11-24-execution-plan.md 的「.env 契约」一节。

# 运行环境：dev（人类可读日志、默认 debug 级别）或 prod（JSON 日志、默认 info 级别）
NETDISK_LFS_ENV=dev

# bdpan CLI 的绝对路径；设置后覆盖 config.toml 里的 storage.bdpan_bin
BDPAN_BIN=/path/to/bdpan

# 运行配置文件路径（TOML）；不传 --config 时使用，再缺省为 ./config.toml
NETDISK_LFS_CONFIG=/path/to/config.toml

# 本地数据根：cache.dir 缺省取 $NETDISK_LFS_DATA_DIR/cache，后续分支的 upload 目录也基于它
NETDISK_LFS_DATA_DIR=/path/to/netdisk-lfs-data
